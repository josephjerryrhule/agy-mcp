{
  "name": "agy-mcp",
  "version": "1.0.0",
  "description": "MCP server enabling Claude Code to delegate tasks to Antigravity (agy) headless subagents",
  "main": "dist/server/stdio.js",
  "type": "module",
  "bin": {
    "agy-mcp": "./dist/server/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/server/stdio.ts",
    "dev": "node --import tsx src/server/stdio.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
